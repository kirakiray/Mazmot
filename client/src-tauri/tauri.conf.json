{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mazmot",
  "version": "1.0.0",
  "identifier": "com.mazmot.runtime",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["mazmot-runtime"]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Mazmot Desktop Runtime",
    "longDescription": "Mazmot 桌面运行时：把 Mazmot 应用平台封装为原生多窗口桌面 Runtime，内置本地站点服务与 NoneOS Core 完整兼容。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../index.html",
      "../../404.html",
      "../../sw.js",
      "../../sw",
      "../../main",
      "../../apps",
      "../../mz",
      "../../official-apps",
      "../../bridge",
      "../../cache-manifest.json",
      "../../locale-text.json"
    ],
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
