{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mazmot-runtime",
  "description": "放行本地静态站点源（localhost 回环端口）的 IPC 访问；Mazmot 命令层无需额外插件权限",
  "windows": ["*"],
  "remote": {
    "urls": [
      "http://localhost:30031",
      "http://localhost:30032",
      "http://localhost:30033",
      "http://localhost:30034",
      "http://localhost:30035",
      "http://localhost:30036",
      "http://127.0.0.1:30031",
      "http://127.0.0.1:30032",
      "http://127.0.0.1:30033",
      "http://127.0.0.1:30034",
      "http://127.0.0.1:30035",
      "http://127.0.0.1:30036"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-runtime-open-window",
    "allow-runtime-navigate-window",
    "allow-runtime-focus-window",
    "allow-runtime-close-window",
    "allow-runtime-set-window-title",
    "allow-runtime-open-external",
    "allow-runtime-probe",
    "allow-runtime-log"
  ]
}
