{
  "name": "mazmot",
  "version": "1.4.2",
  "description": "Robots developing NoneOS applications",
  "homepage": "https://github.com/kirakiray/Mazmot#readme",
  "bugs": {
    "url": "https://github.com/kirakiray/Mazmot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirakiray/Mazmot.git"
  },
  "license": "Apache-2.0",
  "author": "Yao",
  "type": "module",
  "main": "sw.js",
  "scripts": {
    "static": "node scripts/static.js",
    "bump": "node scripts/bump.js && npm run update && npm run build:skill",
    "build:skill": "node scripts/build-skill.js",
    "test": "sb-test",
    "handshake": "printf 'host = \"127.0.0.1\"\\nport = 8081\\nredb_path = \"/tmp/noneos-handshake-dev.redb\"\\n' > /tmp/handshake-dev.toml && test-bin/noneos-handshake-macos-arm64 --config /tmp/handshake-dev.toml",
    "test-ai": "node scripts/test-ai.js",
    "update": "node scripts/update-host-cache.js",
    "cred-hub": "cd server/cred-hub && cargo run --release",
    "ai-relay": "cd server/ai-relay && cargo run --release",
    "cred-hub-e2e": "cd server/cred-hub/e2e && npx playwright test --project=chrome && npx playwright test -c retention.playwright.config.js",
    "ai-relay-e2e": "cd server/ai-relay/e2e && npx playwright test --project=chrome",
    "cred-hub-cf-test": "npm --prefix server/cred-hub-cf install --no-audit --no-fund && npm --prefix server/cred-hub-cf test",
    "bridge": "cd .. && cd web-bridge-mcp && npm run serve:groups"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "sibyl-test": "^1.0.15"
  }
}
