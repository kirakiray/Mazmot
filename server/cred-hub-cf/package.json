{
  "name": "cred-hub-cf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "cred-hub 的 Cloudflare Workers + D1 版本",
  "scripts": {
    "dev": "wrangler dev --port 8788 --local",
    "deploy": "wrangler deploy",
    "init-db:local": "wrangler d1 execute cred-hub --local --file=schema.sql",
    "init-db:remote": "wrangler d1 execute cred-hub --remote --file=schema.sql",
    "test": "node run-tests.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
