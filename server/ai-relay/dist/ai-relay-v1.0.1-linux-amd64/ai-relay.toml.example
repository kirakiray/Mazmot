# ai-relay 配置示例：复制为 ai-relay.toml 后修改；
# 同名环境变量优先于本文件（如 AI_RELAY_ADMIN_TOKEN）。
# 不放本文件也能跑：全部有内置默认值，但管理 API 需要 ADMIN_TOKEN 才开启。

[vars]
AI_RELAY_ADMIN_TOKEN = "change-me-to-a-long-random-token"
# AI_RELAY_PORT = "8791"
# AI_RELAY_DATA = "data/ai-relay.redb"
# 反代 / HTTPS 部署时配置，邀请码里的服务器地址以此为准
# AI_RELAY_PUBLIC_URL = "https://relay.example.com"
# 浏览器直连保持默认放行；由 nginx 统一处理 CORS 时设 0
# AI_RELAY_CORS = "1"
