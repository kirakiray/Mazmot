# cred-hub 配置文件示例。
# 复制为 cred-hub.toml（或经 CRED_HUB_CONFIG 指定路径）后按需修改；
# 全部项均可省略（省略 = 用内置默认值）。环境变量优先于本文件。
# 注意：本文件含管理令牌，不要提交进 Git（建议加入 .gitignore）。

port = 8787                          # 监听端口（env: CRED_HUB_PORT）
data = "data/cred-store.redb"        # redb 数据文件路径（env: CRED_HUB_DATA）
retention_ms = 604800000             # 冷数据保留期，默认 7 天（env: CRED_HUB_RETENTION_MS）
max_cred_bytes = 2048                # 单条 cred 大小上限（env: CRED_HUB_MAX_CRED_BYTES）
cors = false                         # 跨域放行；浏览器直连场景设 true（env: CRED_HUB_CORS=1）
# admin_token = "openssl-rand-base64-32 生成的令牌"  # 未配置 = 管理 API 整体 404（env: CRED_HUB_ADMIN_TOKEN）
