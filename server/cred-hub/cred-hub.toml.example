# cred-hub 配置文件示例。
# 复制为 cred-hub.toml（或经 CRED_HUB_CONFIG 指定路径）后按需修改；
# 与 CF 版 wrangler.toml 的 [vars] 段同构（CRED_HUB_* 同名键、字符串值），
# 两个版本可用同一份配置内容。环境变量优先于本文件。
# 注意：本文件含管理令牌，不要提交进 Git（已加入 .gitignore）。

[vars]
# 监听端口（env: CRED_HUB_PORT）
CRED_HUB_PORT = "8787"
# redb 数据文件路径（env: CRED_HUB_DATA）
CRED_HUB_DATA = "data/cred-store.redb"
# 冷数据保留期毫秒数，默认 7 天（env: CRED_HUB_RETENTION_MS）
CRED_HUB_RETENTION_MS = "604800000"
# 单条 cred 大小上限（env: CRED_HUB_MAX_CRED_BYTES）
CRED_HUB_MAX_CRED_BYTES = "2048"
# 跨域放行；浏览器直连场景设 "1"（env: CRED_HUB_CORS）
CRED_HUB_CORS = "1"
# 管理 API 令牌；未配置 = 管理 API 整体 404（env: CRED_HUB_ADMIN_TOKEN）
# CRED_HUB_ADMIN_TOKEN = "openssl-rand-base64-32 生成的令牌"
